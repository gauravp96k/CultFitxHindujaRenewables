# ── Dependencies ──
node_modules/

# ── Secrets — never commit these ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
nginx/certs/*
!nginx/certs/.gitkeep
nginx/certbot/*
!nginx/certbot/.gitkeep

# ── Personal data ──
# Real employee master lists used by seed-employees.cjs (names, emails, IDs).
# Only the empty template is committed.
backend/seed/*.csv
!backend/seed/employees-template.csv
backend/seed/*.xlsx
# Database dumps / backups
dump/
*.bson
*.archive
*.bak

# ── Build output ──
dist/
dist-ssr/
dev-dist/
build/
coverage/
*.local

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors / OS ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Office lock files (created while a .docx / .xlsx is open)
~$*
