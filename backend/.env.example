# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/cultfit_portal
CLIENT_URL=http://localhost:5173

# --- Login ---
# Long random strings (at least 32 characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
OTP_SECRET=
CORPORATE_DOMAIN=hindujarenewables.com
# Comma-separated emails that become Super Admin on login (optional; or use: npm run create-super-admin)
SUPER_ADMIN_EMAILS=

# --- Per-network rate limits, per 15 minutes (optional; defaults shown) ---
# Everyone in an office shares one public IP, so size these for a whole office.
# Per-person OTP limits (30 s cooldown, 5 per hour, 5 wrong tries) always apply.
OTP_SEND_LIMIT_PER_IP=150
OTP_VERIFY_LIMIT_PER_IP=300
API_LIMIT_PER_IP=3000

# --- Development shortcuts (ignored when NODE_ENV=production) ---
# true = OTP 123456 works for everyone
DEV_OTP_BYPASS=false
# true = any @CORPORATE_DOMAIN email can log in without being imported first
AUTO_PROVISION_USERS=true

# --- Email for OTPs: smtp or graph ---
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Microsoft Graph (only when MAIL_PROVIDER=graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
